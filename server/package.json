{
  "name": "smart-resort-360-server",
  "version": "1.0.0",
  "description": "Smart Resort 360 - AI-powered resort operations backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node --transpile-only src/seed.ts",
    "type-check": "tsc --noEmit",
    "db:local": "easydb-server --adapter sqlite --data .localdb --port 27017",
    "seed:resort": "ts-node --transpile-only src/scripts/seedResort.ts",
    "seed:all": "npm run seed:resort && npm run seed"
  },
  "keywords": [
    "resort",
    "management",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rckflr/easydb-server": "^0.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.3",
    "better-sqlite3": "^13.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1",
    "zod": "^4.6.5"
  }
}